        "patchSetId": 1
      },
      "lineNbr": 5345,
      "author": {
        "id": 1651802
      },
      "writtenOn": "2026-11-04T22:16:12Z",
      "side": 1,
      "message": "Yes. The first version only accepted block aligned requests, and the callers had to fall back to preadv2() otherwise. The AICore/LiteRT team asked for unaligned support: their offsets and lengths are almost never block aligned, and they don\u0027t want to fix every load path in the applications. wrapfd handles this with bounce buffers for the same reason, so this follows it.",
      "parentUuid": "d9322c07_83b9ee20",
      "range": {
        "startLine": 5340,
        "startChar": 3,
        "endLine": 5345,
        "endChar": 37
      },
      "revId": "0aca328104fd189ff78028672892ee8f63bcab30",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
