    {
      "unresolved": true,
      "key": {
        "uuid": "48e5c45e_7016eedd",
        "filename": "fs/f2fs/file.c",
        "patchSetId": 1
      },
      "lineNbr": 5380,
      "author": {
        "id": 1137063
      },
      "writtenOn": "2026-11-04T02:12:30Z",
      "side": 1,
      "message": "The proposed sepolicy CL http://ag/43496624 allows this ioctl to **all domains**, so it seems the only meaningful safeguard would be the ability to get a dma_buf file descriptor.  Don\u0027t all Android apps already have access to a number of such file descriptors, though?  Graphics, camera, etc.",
      "range": {
        "startLine": 5380,
        "startChar": 10,
        "endLine": 5380,
        "endChar": 37
      },
      "revId": "0aca328104fd189ff78028672892ee8f63bcab30",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
