      "writtenOn": "2026-11-04T02:12:30Z",
      "side": 1,
      "message": "Do non-block-aligned offsets and lengths need to be supported at all?",
      "range": {
        "startLine": 5340,
        "startChar": 3,
        "endLine": 5345,
        "endChar": 37
      },
      "revId": "0aca328104fd189ff78028672892ee8f63bcab30",
